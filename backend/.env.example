# Express server port
PORT=4000

# CORS origin for the React dev server
CORS_ORIGIN=http://localhost:5173

# --- Firebase Admin ---
# Path to a service account JSON downloaded from Firebase Console
# (Project Settings → Service accounts → Generate new private key).
# Якщо не задано — API працює "у пам'яті" (in-memory store з seed JSON),
# зручно для розробки без реального Firebase.
GOOGLE_APPLICATION_CREDENTIALS=

# Project ID (also taken from service account JSON if available)
FIREBASE_PROJECT_ID=

# Comma-separated admin emails (matched against Firebase Auth ID token)
ADMIN_EMAILS=admin@techstore.ua

# Use Firebase Emulator for Firestore / Auth (matches frontend setting)
USE_FIREBASE_EMULATOR=false
