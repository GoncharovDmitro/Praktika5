# API URL (relative paths use Vite proxy in dev)
VITE_API_URL=/api

# Set to "true" to load products from the bundled JSON instead of API.
# Useful for previewing the React app without Firebase / backend running.
VITE_USE_LOCAL_DATA=true

# Firebase web config — заповнюється з Firebase Console (Project Settings → General → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Enable Firebase Emulator Suite during local dev
VITE_USE_FIREBASE_EMULATOR=false
