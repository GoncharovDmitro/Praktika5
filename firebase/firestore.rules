rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Адмінів визначаємо за custom claim `admin: true` у Firebase Auth.
    // Альтернатива: список email у документі `/admins/{email}`.
    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.admin == true ||
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }

    match /products/{productId} {
      allow read: if true;            // каталог — публічний
      allow write: if isAdmin();      // CRUD — лише адмін
    }

    match /orders/{orderId} {
      // Створювати замовлення може будь-хто (гість або користувач).
      allow create: if request.resource.data.items.size() > 0;
      // Читати — власник або адмін.
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      // Оновлювати/видаляти — тільки адмін.
      allow update, delete: if isAdmin();
    }

    match /admins/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
